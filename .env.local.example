# Copy to .env.local and fill in real values. Never commit .env.local.

# Public — safe to expose to the browser (RLS protects the data, not these).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Required only for /api/users/create-cashier (owner creating a cashier login).
SUPABASE_SERVICE_ROLE_KEY=
